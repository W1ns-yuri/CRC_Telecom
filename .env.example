# Адрес сайта (для canonical, hreflang, sitemap)
NEXT_PUBLIC_SITE_URL=https://crc-telecom.ca

# Cloudflare Turnstile (защита форм от спама). Без ключей формы работают, но без капчи.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (отправка писем: заявка на office@ и подтверждение посетителю)
RESEND_API_KEY=
MAIL_FROM="CRC Telecom <no-reply@crc-telecom.ca>"
MAIL_TO=office@crc-telecom.ca

# Sanity (хранение заявок и согласий; позже — контент сайта)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_WRITE_TOKEN=

# Google Analytics 4 — загружается только после согласия на аналитические cookie
NEXT_PUBLIC_GA_ID=
